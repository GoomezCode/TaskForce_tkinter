# Copy to `.env` and adjust. The app also accepts real environment variables
# with the same names (env vars take precedence over this file).

# Base URL of the TaskForce API v2. The API root alone is accepted too
# (it is normalized to .../api/v1/tasks automatically).
# Production: https://taskforce-api-zxag.onrender.com/api/v1/tasks
# Local dev:  http://localhost:8000/api/v1/tasks
TASKFORCE_API_URL=https://taskforce-api-zxag.onrender.com/api/v1/tasks

# HTTP timeout in seconds (1-120).
TASKFORCE_TIMEOUT=10

# Default page size for the task list (1-100).
TASKFORCE_PAGE_SIZE=20
